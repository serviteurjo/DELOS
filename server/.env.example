# ============================================================
# DELOS 2026 — Email Server (Express + Nodemailer/Gmail)
# Copier ce fichier en `.env` puis remplir vos valeurs.
# SMTP_PASS = mot de passe d'APPLICATION Gmail à 16 lettres
# (Compte Google → Sécurité → Validation 2 étapes →
#  Mots de passe des applications). JAMAIS le mot de passe normal.
# ============================================================

SMTP_USER=delos2026centrecev@gmail.com
SMTP_PASS=xxxxxxxxxxxxxxxx
MAIL_FROM=DELOS 2026 <delos2026centrecev@gmail.com>
ADMIN_TOKEN=delos-admin-2026
PORT=3001

# En production (Render) : liste d'origines autorisées (séparées par des virgules).
# Vide en local = CORS ouvert (mode dev). Exemple :
# ALLOWED_ORIGINS=https://delos2026.vercel.app